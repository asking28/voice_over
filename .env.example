# Copy to .env and fill in.

# Required — covers both transcription (nova-3) and the default TTS voices (aura-2).
DEEPGRAM_API_KEY=""

# Optional — only needed to use the Cartesia TTS provider or voice cloning (--clone).
CARTESIA_API_KEY=""

# Optional overrides
DEEPGRAM_MODEL="nova-3"
DEEPGRAM_VOICE="aura-2-thalia-en"
CARTESIA_MODEL="sonic-3.5"
CARTESIA_VOICE_ID="a0e99841-438c-4a64-b679-ae501e7d6091"
CARTESIA_VERSION="2024-11-13"
REVOICE_PORT="8010"
